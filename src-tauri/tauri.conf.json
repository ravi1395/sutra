{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sutra",
  "version": "2.3.44",
  "identifier": "com.ravi1395.sutra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:* https:; frame-src http://127.0.0.1:* http://localhost:* https:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt", "md", "markdown", "json", "jsonc", "yaml", "yml", "toml", "xml", "csv",
          "html", "htm", "css", "scss", "less",
          "js", "jsx", "mjs", "cjs", "ts", "tsx",
          "rs", "go", "py", "rb", "java", "kt", "kts", "c", "h", "cpp", "hpp", "cc", "cs",
          "php", "swift", "sh", "bash", "zsh", "sql", "lua", "vue", "svelte",
          "gitignore", "env", "conf", "ini", "log"
        ],
        "name": "Source Code",
        "description": "Text or source-code file",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ravi1395/sutra/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFERTJEMDlEREI3RDMwMUIKUldRYk1IM2JuZERpcmY4em1NVk54Ym9Xb0MrZm9zYnRFNzhZcEwvdnpPZHNzVzZmZzYzeE9PN1AK"
    }
  }
}
